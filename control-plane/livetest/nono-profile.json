{
  "meta": {
    "name": "ortus-cp-live-test",
    "description": "nono's profile in the control plane's live tests: the model credential bound to the fake model API (model.cp.test), which only POSTs under /v1/ reach"
  },
  "network": {
    "allow_domain": ["model.cp.test"],
    "credentials": ["anthropic"],
    "custom_credentials": {
      "anthropic": {
        "upstream": "https://model.cp.test",
        "credential_key": "env://CP_EGRESS_ANTHROPIC",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "tls_ca": "/etc/nono/model-ca.crt",
        "endpoint_rules": [{"method": "POST", "path": "/v1/**"}]
      }
    }
  }
}
