# The telemetry store's settings (README.md, "Settings"): the one
# environment file of the compose project ortus-telemetry. telemetry.sh init
# copies this to $TELEMETRY_HOME/telemetry.env and fills in the project's
# public key; edit it there, then run telemetry.sh up again.
#
# Each key is named after the Helm chart value that holds the same setting:
# the value's path in capitals, with each dot, dash and change of case an
# underscore. Langfuse's chart is at the top (langfuse.nextauth.url is
# LANGFUSE_NEXTAUTH_URL), the collector's chart sits under the alias
# `collector` (collector.ports.otlp.hostPort is COLLECTOR_PORTS_OTLP_HOST_PORT),
# and a setting the Langfuse chart passes only as langfuse.additionalEnv
# keeps its variable's name. TELEMETRY_* are the kit's own: no chart holds
# them. Secrets are not here: they are files in $TELEMETRY_HOME/secrets.

# Langfuse (langfuse.*)
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_WEB_SERVICE_PORT=3000
LANGFUSE_FEATURES_SIGN_UP_DISABLED=true
LANGFUSE_FEATURES_TELEMETRY_ENABLED=false
LANGFUSE_FEATURES_EXPERIMENTAL_FEATURES_ENABLED=false
LANGFUSE_LOGGING_LEVEL=info
LANGFUSE_LOGGING_FORMAT=text

# Headless initialisation (langfuse.additionalEnv): one organisation, one
# project with its key pair, and the operator's user.
LANGFUSE_INIT_ORG_ID=ortus-nova
LANGFUSE_INIT_ORG_NAME=Ortus-Nova
LANGFUSE_INIT_PROJECT_ID=agent-platform
LANGFUSE_INIT_PROJECT_NAME=agent-platform
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_USER_EMAIL=operator@ortusnova.example
LANGFUSE_INIT_USER_NAME=operator

# PostgreSQL (postgresql.*)
POSTGRESQL_AUTH_USERNAME=langfuse
POSTGRESQL_AUTH_DATABASE=langfuse

# ClickHouse (clickhouse.*)
CLICKHOUSE_AUTH_USERNAME=default
CLICKHOUSE_DATABASE=default

# Valkey (redis.*)
REDIS_AUTH_USERNAME=default

# MinIO (s3.*): Langfuse uses its root user as its access key.
S3_BUCKET=langfuse
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_AUTH_ROOT_USER=langfuse
S3_EVENT_UPLOAD_PREFIX=events/
S3_MEDIA_UPLOAD_PREFIX=media/
S3_BATCH_EXPORT_ENABLED=false

# The OpenTelemetry Collector (collector.*)
COLLECTOR_PORTS_OTLP_HOST_PORT=4317
COLLECTOR_PORTS_OTLP_HTTP_HOST_PORT=4318
COLLECTOR_CONFIG_EXPORTERS_OTLP_HTTP_LANGFUSE_HEADERS_X_LANGFUSE_INGESTION_VERSION=4
COLLECTOR_CONFIG_EXPORTERS_FILE_ROTATION_MAX_MEGABYTES=100

# The kit's own
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_BACKUP_KEEP=7
