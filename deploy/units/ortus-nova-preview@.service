[Unit]
Description=Ortus Nova @ORTUS_NOVA_ENV@: the preview of %i's pull request, a read-only workbench
After=@UNIT_PREFIX@sortie.service

[Service]
Type=exec
Environment=ORTUS_NOVA_HOME=@ORTUS_NOVA_HOME@
Environment=ORTUS_NOVA_ENV=@ORTUS_NOVA_ENV@
ExecStart=@KIT@/run-workbench.sh %i
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
