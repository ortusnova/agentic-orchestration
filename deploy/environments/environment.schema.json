{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ortusnova/agentic-orchestration/deploy/environments/environment.schema.json",
  "title": "An environment of the agent platform",
  "description": "deploy/environments/<env>.yml: which host runs what, and the environment's own values (spec store deploy-environments, design D2). A key this schema does not define is refused, never ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hosts", "control", "ports", "tracker"],
  "properties": {
    "version": { "const": 1 },
    "stage0_names": {
      "description": "A host installed under the stage-0 names deploys as this environment, under those names, until it is migrated (design D6). At most one environment sets it; drop-stage0-names removes the key.",
      "type": "boolean"
    },
    "hosts": {
      "description": "Each machine id, the host's lower-case short host name (hostname -s), and what it runs. Exactly one host runs control.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/dns_label" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runs"],
        "properties": {
          "ssh": {
            "description": "The SSH destination the control host reaches this host by (design D3); the machine id when unset. The only place it is declared.",
            "type": "string",
            "pattern": "^[A-Za-z0-9._@-]+$"
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["control", "worker"] }
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_port"],
      "properties": {
        "front_port": {
          "description": "Pomerium's port; the control plane's URL is https://<control host's FQDN>:<front_port>.",
          "$ref": "#/$defs/port"
        }
      }
    },
    "ports": {
      "description": "Loopback ports on the hosts of this environment. No two environments share one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sortie", "workbench", "nono", "nono_live_proof", "egress_gate", "previews_from"],
      "properties": {
        "sortie": { "$ref": "#/$defs/port" },
        "workbench": { "$ref": "#/$defs/port" },
        "nono": { "$ref": "#/$defs/port" },
        "nono_live_proof": { "$ref": "#/$defs/port" },
        "egress_gate": { "$ref": "#/$defs/port" },
        "previews_from": { "description": "The first preview port.", "$ref": "#/$defs/port" }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "workspace", "project"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" },
        "workspace": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" }
      }
    },
    "local_names": {
      "description": "Local names in homelab's local-names directory; empty for none. No two environments share one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workbench": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" }
      }
    }
  },
  "$defs": {
    "dns_label": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
  }
}
