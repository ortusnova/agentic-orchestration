#!/bin/sh
# git's credential helper for GitHub in a job's machine (gitconfig-github):
# it answers https://github.com/<owner>/... with the placeholder Sortie
# bound for that owner, SORTIE_GITHUB_TOKEN_<OWNER> (the owner upper-cased,
# each other character than a letter or a digit as _), as the password of
# x-access-token. The machine holds no token: the egress gate replaces the
# placeholder with the attempt's token of that owner. An owner the job is
# granted nothing on gets no answer, so git asks no further and fails.
[ "${1:-}" = get ] || exit 0
protocol='' host='' path=''
while IFS= read -r line && [ -n "$line" ]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
owner=${path%%/*}
[ -n "$owner" ] || exit 0
var=SORTIE_GITHUB_TOKEN_$(printf %s "$owner" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')
# var holds only A-Z, 0-9 and _, so it is safe to expand by name.
eval "placeholder=\${$var:-}"
[ -n "$placeholder" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$placeholder"
