{
  "meta": {
    "name": "ortus-stage0-egress",
    "description": "The egress flow of the stage-1 edge on p1 (dev/stage0/README.md): the hosts the workflow allows, and the credentials it binds, read by run-nono.sh"
  },
  "network": {
    "allow_domain": [
      "api.anthropic.com",
      "api.github.com",
      "github.com",
      "models.opencode.ai",
      "proxy.golang.org",
      "registry.npmjs.org",
      "storage.googleapis.com",
      "sum.golang.org"
    ],
    "credentials": ["anthropic", "github_api", "github_git"],
    "custom_credentials": {
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://STAGE0_EGRESS_ANTHROPIC",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "github_api": {
        "upstream": "https://api.github.com",
        "credential_key": "env://STAGE0_EGRESS_GITHUB",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "env://STAGE0_EGRESS_GITHUB_BASIC",
        "inject_mode": "basic_auth"
      }
    }
  }
}
