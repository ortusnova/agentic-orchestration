{
  "meta": {
    "name": "ortus-stage0-egress",
    "description": "The egress flow of the stage-1 edge on p1 (dev/stage0/README.md): the hosts a job of any repository may reach, and the credentials the workflow binds, read by run-nono.sh"
  },
  "network": {
    "allow_domain": [
      "*.githubusercontent.com",
      "*.pkg.dev",
      "*.quay.io",
      "api.anthropic.com",
      "api.github.com",
      "auth.docker.io",
      "cdimage.debian.org",
      "charts.jetstack.io",
      "charts.longhorn.io",
      "cloudnative-pg.github.io",
      "codeload.github.com",
      "deb.debian.org",
      "files.pythonhosted.org",
      "ghcr.io",
      "github.com",
      "kubernetes.github.io",
      "models.opencode.ai",
      "production.cloudflare.docker.com",
      "production.cloudfront.docker.com",
      "proxy.golang.org",
      "pypi.org",
      "quay.io",
      "registry-1.docker.io",
      "registry.k8s.io",
      "registry.npmjs.org",
      "security.debian.org",
      "storage.googleapis.com",
      "sum.golang.org"
    ],
    "credentials": ["anthropic", "github_api", "github_git"],
    "custom_credentials": {
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://STAGE0_EGRESS_ANTHROPIC",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "github_api": {
        "upstream": "https://api.github.com",
        "credential_key": "env://STAGE0_EGRESS_GITHUB",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "github_git": {
        "upstream": "https://github.com",
        "credential_key": "env://STAGE0_EGRESS_GITHUB_BASIC",
        "inject_mode": "basic_auth"
      }
    }
  }
}
