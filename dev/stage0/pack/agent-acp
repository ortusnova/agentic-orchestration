#!/bin/sh
# The one ACP agent command of the stage-0 workflow. Sortie sets SORTIE_RULE
# to the dispatch rule a run was dispatched under: a rule whose name starts
# with "claude" runs Claude Code (claude-agent-acp), anything else opencode.
# Both use the operator's Claude subscription through CLAUDE_CODE_OAUTH_TOKEN,
# which in the VM holds only smolvm's placeholder; smolvm swaps in the real
# token on requests to api.anthropic.com.
case "${SORTIE_RULE:-}" in
  claude*) agent=claude ;;
  *) agent=opencode ;;
esac
if [ "${1:-}" = --which ]; then echo "$agent"; exit 0; fi
# The run's token usage, which agent-usage prints for the worker daemon:
# opencode's sortie-usage plugin writes it. A file an earlier run in this
# machine left goes first, so a run that records none is never reported
# with another run's numbers.
usage=${SORTIE_USAGE_FILE:-$HOME/.local/state/sortie/usage.json}
rm -f "$usage" "$usage.log"
case "$agent" in
  claude) exec claude-agent-acp "$@" ;;
  *)
    # opencode 2 keeps credentials in its own store. Import the Claude
    # subscription login the sign-in plugin reads (method claude-max), with
    # the placeholder as its access token and an expiry it never refreshes.
    # A second import of the same ID is skipped, so drop the old one first:
    # the placeholder may change between runs in one machine.
    umask 077
    id=cred_000000000000stage0anthropic
    opencode auth logout --standalone anthropic "$id" </dev/null >&2 || true
    cred=$(mktemp)
    printf '[{"id":"%s","integrationID":"anthropic","label":"Claude subscription","active":true,"value":{"type":"oauth","methodID":"claude-max","refresh":"","access":"%s","expires":4102444800000}}]\n' \
      "$id" "${CLAUDE_CODE_OAUTH_TOKEN:?}" > "$cred"
    opencode auth import --standalone "$cred" >&2 || { rm -f "$cred"; exit 1; }
    rm -f "$cred"
    # opencode reads the login from its store, and every shell command it
    # runs inherits its environment. A command that prints it (a test's
    # traceback with os.environ, say) puts the placeholder into the model's
    # input, and smolvm refuses every later request of that session ("a
    # request may carry one placeholder").
    unset CLAUDE_CODE_OAUTH_TOKEN
    export SORTIE_USAGE_FILE="$usage"
    exec opencode acp "$@" ;;
esac
