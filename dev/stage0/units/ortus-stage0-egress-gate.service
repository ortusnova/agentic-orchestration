[Unit]
Description=Ortus Nova stage 1: the egress gate behind Pomerium's egress route
After=network-online.target ortus-stage0-nono.service

[Service]
Type=exec
Environment=STAGE0_HOME=@STAGE0_HOME@
ExecStart=@KIT@/run-egress-gate.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
