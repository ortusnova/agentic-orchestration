[Unit]
Description=Ortus Nova stage 1: the worker daemon, which runs the control plane's jobs on this host
After=network-online.target ortus-stage0-pomerium.service

[Service]
Type=exec
# smolvm, from homelab's dev host or the operator's ~/.local/bin.
Environment=PATH=@STAGE0_HOME@/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@STAGE0_HOME@/bin/worker-daemon run -config @STAGE0_HOME@/worker.json
Restart=on-failure
RestartSec=10
# The daemon leaves its running jobs to its next start, which adopts them.
TimeoutStopSec=150
# The jobs' machines run in this unit's control group: a stop signals the
# daemon only, so they outlive it.
KillMode=process

[Install]
WantedBy=default.target
