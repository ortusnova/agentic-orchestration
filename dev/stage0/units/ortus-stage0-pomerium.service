[Unit]
Description=Ortus Nova stage 1: Pomerium, the control plane's only door for every worker
After=network-online.target ortus-stage0-egress-gate.service

[Service]
Type=exec
Environment=STAGE0_HOME=@STAGE0_HOME@
ExecStart=@KIT@/run-pomerium.sh
ExecStop=-podman stop -t 10 ortus-stage0-pomerium
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
