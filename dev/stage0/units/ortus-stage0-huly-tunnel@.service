[Unit]
Description=Ortus Nova stage 0: p1's Huly on %i's loopback, for its homelab Sortie
After=network-online.target podman-restart.service

[Service]
Type=exec
# A remote forward: Huly listens on p1's loopback only, and appears on the
# homelab host's loopback only. Nothing listens on the LAN, and the homelab
# host gets no way back into p1 (spec store run-homelab-through-sortie, D10).
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -R 127.0.0.1:8087:127.0.0.1:8087 %i
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
