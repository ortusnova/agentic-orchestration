[Unit]
Description=Ortus Nova stage 0: the telemetry store, Langfuse and its OpenTelemetry Collector (compose project ortus-telemetry)
After=podman-restart.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=STAGE0_HOME=@STAGE0_HOME@
ExecStart=@KIT@/run-telemetry.sh up
ExecStop=@KIT@/run-telemetry.sh down
# The first start pulls the images.
TimeoutStartSec=1800

[Install]
WantedBy=default.target
